# Copy to .env and fill in. Never commit your real .env.
#
# Prefer not to keep secrets in plaintext? Any key below can instead live in the
# macOS Keychain (looked up automatically when the env var is unset):
#   security add-generic-password -a "$USER" -s ANTHROPIC_API_KEY -w 'sk-ant-...'
# Resolution order is: environment / .env first, then Keychain.

# Anthropic (resume tailoring + fit scoring)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: run a different Claude model than the built-in default,
# claude-opus-4-8. A cheaper model looks like the example below; the cost
# estimate on the Data page follows whichever model is set.
# JOBPILOT_MODEL=claude-sonnet-4-6

# Adzuna job search API (free signup: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble job search API (free key: https://jooble.org/api/about)
JOOBLE_API_KEY=
